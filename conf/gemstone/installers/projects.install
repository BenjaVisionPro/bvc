# conf/bvc/projects.install.sh
# Sourced helper. Defines: install_projects "<gitDir>"

install_projects() {

  gitDir="$1"
  : "${gitDir:?gitDir is required}"

  information_banner "Installing Catalyst Foundation"
  installProject.stone "file:${gitDir}/CatalystFoundation/rowan/specs/CatalystFoundation.ston" \
    --projectsHome="${gitDir}" -D

  information_banner "Installing Catalyst Runtime"
  installProject.stone "file:${gitDir}/CatalystRuntime/rowan/specs/CatalystRuntime.ston" \
    --projectsHome="${gitDir}" -D

  information_banner "Installing Catalyst Process"
  installProject.stone "file:${gitDir}/CatalystProcess/rowan/specs/CatalystProcess.ston" \
    --projectsHome="${gitDir}" -D

  information_banner "Installing GsApplicationTools"
  installProject.stone "file:${gitDir}/gsApplicationTools/rowan/specs/gsApplicationTools.ston" \
    --projectsHome="${gitDir}" -D

}