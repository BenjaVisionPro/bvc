expectvalue true
run
#(CRGemStoneLocalWorker TonelRepository CFConfiguration CRRuntimeConfigurationCodec) do: [:name |
 (Smalltalk includesKey: name) ifFalse: [self error: 'Missing native Runtime prerequisite: ', name asString]].
true
%
expectvalue true
run
GsDeployer deploy: [
 | repository url fingerprint |
 url := System gemEnvironmentVariable: 'BVC_CONNECT_REPOSITORY'.
 fingerprint := System gemEnvironmentVariable: 'BVC_FOUNDATION_SOURCE_VERSION'.
 repository := TonelRepository new directory: (MetacelloPlatform current fileHandleOn:
  (url copyFrom: 'tonel://' size + 1 to: url size)).
 "Keep native overrides after common code. Reuse all provisioned prerequisites."
 #('BVC-Connect-Quic-Core' 'BVC-Connect-Quic-GemStone' 'BVC-Connect-Quic-Configuration') do: [:name |
  Gofer new repository: repository; version: name, '-bvc.', fingerprint; load]].
true
%
commit
set transactionmode manualBegin
expectvalue true
run
| native buffer bytes decoded configuration loaded expected report file |
CRPlatform current class = CRGemStonePlatform ifFalse: [self error: 'Native Runtime platform required'].
native := CRPlatform current newConnectQuicNative. buffer := native newBuffer: 16.
[native copy: 8 from: #[1 2 3 4 5 6 7 8] at: 0 into: buffer.
 (native uint64At: 0 in: buffer) = 16r0807060504030201 ifFalse: [self error: 'Native buffer decoding differs']]
 ensure: [native freeBuffer: buffer].
buffer isDead ifFalse: [self error: 'Native buffer was not released'].
configuration := CCQuicConfiguration new.
decoded := CRRuntimeConfigurationCodec decodeObject: (CRRuntimeConfigurationCodec encodeObject: configuration).
(decoded class == CCQuicConfiguration and: [decoded applicationClass == CCQuicEchoApplication])
 ifFalse: [self error: 'Runtime codec lost Connect configuration'].
expected := #('BVC-Connect-Quic-Core' 'BVC-Connect-Quic-GemStone' 'BVC-Connect-Quic-Configuration').
loaded := MCWorkingCopy allManagers select: [:manager | expected includes: manager package name]
 thenCollect: [:manager | manager package name].
loaded asSet = expected asSet ifFalse: [self error: 'Missing Connect production packages'].
report := Dictionary new at: 'stone' put: (System gemEnvironmentVariable: 'STONE');
 at: 'packages' put: loaded asSortedCollection asArray;
 at: 'nativeBufferRoundtrip' put: true; at: 'runtimeConfigurationRoundtrip' put: true;
 at: 'socketServicesConfigured' put: false; at: 'gtUIAndExamplesRequested' put: false; yourself.
file := GsFile openWriteOnServer: (System gemEnvironmentVariable: 'BVC_CONNECT_REPORT').
[file nextPutAll: (STON toJsonString: report)] ensure: [file close]. true
%
