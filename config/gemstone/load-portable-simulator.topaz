iferr 1 stk
iferr 2 stack
iferr 3 exit

## The Foundation bootstrap supplies the pinned Tonel reader and Metacello.
## Load unchanged GT exports directly: the old Gofer adapter expects version metadata.
expectvalue true
run
| source packages |
source := System gemEnvironmentVariable: 'BVC_SIMULATOR_SOURCE'.
source isNil ifTrue: [self error: 'BVC_SIMULATOR_SOURCE is required'].
#(TonelMCReader BaselineOf GsDeployer) do: [:name |
 (Smalltalk includesKey: name) ifFalse: [self error: 'Missing Simulator prerequisite: ', name asString]].
packages := #('BaselineOfCatalystSimulator' 'BVC-Simulator-Core').
(System gemEnvironmentVariable: 'BVC_SIMULATOR_LOAD_RUNTIME') = '1' ifTrue: [
 #(CRWorkerService CRServiceBoundCapability CRGemStoneTransactionBackend) do: [:name |
  (Smalltalk includesKey: name) ifFalse: [self error: 'Load native Runtime before Simulator Runtime']].
 packages := packages, #('BVC-Simulator-Authority' 'BVC-Simulator-Runtime')].
GsDeployer deploy: [| directory definitions pending ready |
 directory := MetacelloPlatform current fileHandleOn: source.
 packages do: [:package |
  definitions := (TonelMCReader on: directory fileName: package) snapshot definitions reject: [:d | d isOrganizationDefinition].
  pending := (definitions select: [:d | d isClassDefinition]) asOrderedCollection.
  [pending notEmpty] whileTrue: [
   ready := pending reject: [:d | pending anySatisfy: [:parent | parent className asString = d superclassName asString]].
   ready isEmpty ifTrue: [self error: 'Cyclic Simulator source dependencies'].
   ready do: [:d | d load]. pending removeAll: ready].
  (definitions select: [:d | d isMethodDefinition]) do: [:d | d load]]].
true
%
commit

expectvalue true
run
| directory packages proofs expected actual builder model backend restored checkpoint entity report file |
directory := MetacelloPlatform current fileHandleOn: (System gemEnvironmentVariable: 'BVC_SIMULATOR_SOURCE').
proofs := OrderedCollection new.
packages := #('BaselineOfCatalystSimulator' 'BVC-Simulator-Core').
(System gemEnvironmentVariable: 'BVC_SIMULATOR_LOAD_RUNTIME') = '1' ifTrue: [
 packages := packages, #('BVC-Simulator-Authority' 'BVC-Simulator-Runtime')].
packages do: [:package |
 expected := (TonelMCReader on: directory fileName: package) snapshot definitions reject: [:d | d isOrganizationDefinition].
 actual := (MCPackage named: package) snapshot definitions reject: [:d | d isOrganizationDefinition].
 (expected size = actual size and: [expected allSatisfy: [:d | actual includes: d]]) ifFalse: [self error: 'Simulator source mismatch: ', package].
 proofs add: {package. expected size}].
builder := CSModelBuilder named: 'bvc-install-probe'.
builder node: 'enabled' operation: 'core.constant' stage: 'events' scope: 'world' type: 'bool' inputs: #() after: #() parameters: (Dictionary new at: 'value' put: true; yourself).
builder node: 'events' operation: 'core.events.apply' stage: 'events' scope: 'world' type: 'void' inputs: #() after: #() parameters: Dictionary new.
builder node: 'move' operation: 'core.motion.integrate' stage: 'motion' scope: 'entity' type: 'void' inputs: #('enabled') after: #() parameters: Dictionary new.
model := builder build.
backend := CSSmalltalkBackend model: model seed: 42.
entity := '00000000000000000000000000000001'.
backend addEntity: entity position: #(0 0 0) velocity: #(1000 0 0).
backend advance.
((backend snapshot at: 'entities') at: entity) second = #(100 0 0) ifFalse: [self error: 'Simulator graph movement probe failed'].
checkpoint := backend checkpoint.
restored := CSSmalltalkBackend fromCheckpoint: checkpoint.
backend advance. restored advance.
backend checkpoint = restored checkpoint ifFalse: [self error: 'Simulator graph continuation differs after restore'].
(backend snapshot at: 'modelDigest') = model digest ifFalse: [self error: 'Simulator model digest mismatch'].
report := Dictionary new
 at: 'stone' put: (System gemEnvironmentVariable: 'STONE');
 at: 'group' put: (packages size = 2 ifTrue: ['simulator-core'] ifFalse: ['simulator-runtime']);
 at: 'packages' put: packages;
 at: 'sourceDefinitions' put: proofs asArray;
 at: 'modelDigest' put: model digest;
 at: 'graphMovement' put: true;
 at: 'checkpointContinuation' put: true;
 yourself.
file := GsFile openWriteOnServer: (System gemEnvironmentVariable: 'BVC_SIMULATOR_REPORT').
[file nextPutAll: (STON toString: report)] ensure: [file close].
true
%
errorCount
exit
