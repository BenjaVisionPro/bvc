# Temporary Metacello route. Rowan deployment installers are separate.
install_seaside_projects() {
  local recipe
  export BVC_SIMULATOR_SOURCE="${BVC_SIMULATOR_SOURCE:-${gitDir_projects}/catalyst-simulator/src}"
  export BVC_SIMULATOR_REPORT="${BVC_SIMULATOR_REPORT:-${stoneDir}/portable-simulator-validation.ston}"
  export BVC_RUNTIME_REPOSITORY="${BVC_RUNTIME_REPOSITORY:-tonel://${gitDir_projects}/CatalystRuntime/src}"
  export BVC_RUNTIME_REPORT="${BVC_RUNTIME_REPORT:-${stoneDir}/portable-runtime-validation.ston}"
  export BVC_SIMULATOR_LOAD_RUNTIME=1
  [ -d "$BVC_SIMULATOR_SOURCE" ] || { error_banner "Missing Simulator sources: ${BVC_SIMULATOR_SOURCE}"; return 1; }
  [ -d "${BVC_RUNTIME_REPOSITORY#tonel://}" ] || { error_banner "Missing native Runtime sources"; return 1; }
  recipe=$(conf_resolve 'gemstone/load-portable-foundation.topaz')
  topaz -l -I "${gitDir_devtools}/gt4gemstone/scripts/loginDataCurator.topaz" \
    -S "$recipe" < /dev/zero || return
  recipe=$(conf_resolve 'gemstone/load-portable-runtime.topaz')
  topaz -l -I "${gitDir_devtools}/gt4gemstone/scripts/loginDataCurator.topaz" \
    -S "$recipe" < /dev/zero || return
  recipe=$(conf_resolve 'gemstone/load-portable-simulator.topaz')
  topaz -l -I "${gitDir_devtools}/gt4gemstone/scripts/loginDataCurator.topaz" \
    -S "$recipe" < /dev/zero
}
