#!/usr/bin/env bash
set -euo pipefail

PROGNAME=$0
SCRIPT_DIR=$(cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)

# shellcheck disable=SC1091
. "${SCRIPT_DIR}/private/shFunctions"

load_bvc_config
setup_traps

print_help() {
  cat <<EOF_HELP
Usage: $(prog_basename "$PROGNAME") <command> [args]

Commands:
  init [directory] [--template=NAME]
      Initialise the current directory, or create and initialise directory.

  build [--with-seaside]
      Build the DevKit/app and configured GemStone deployment, then run both.

  run
      Build the DevKit/app if needed, then launch it. Does not start GemStone.

  list
      List registered deployments and currently running stones.

  start <deploymentName> [--with-seaside]
      Start a deployment, building a Rowan stone first if needed.
      --with-seaside selects a Seaside/GT DevKit stone with portable Foundation.

  stop <deploymentName>
      Stop a deployment.

  delete <deploymentName> [-f|--force]
      Delete a deployment and its associated data.
      Prompts for confirmation unless --force is provided.

Examples:
  bvc init ThatGameCatalyst
  cd ThatGameCatalyst
  bvc build
  bvc run
  bvc list
  bvc start tgc-prod-test
  bvc stop tgc-prod-test
  bvc delete tgc-prod-test

Notes:
- Config precedence: ENV > project config > bundled toolkit config > safety net.
- GsDevKit registry selection is internal and comes from DEFAULT_REGISTRY in config.
- build uses GEMSTONE_STONE_NAME for the project's deployment.
- start, stop, list and delete operate on GemStone only.
EOF_HELP
}

if [ $# -gt 0 ]; then
  cmd=$1
  shift
else
  cmd=help
fi

case "$cmd" in
  init)           exec "${SCRIPT_DIR}/bvcInitProject.sh" "$@" ;;
  build)          exec "${SCRIPT_DIR}/bvcBuild.sh" "$@" ;;
  run)            exec "${SCRIPT_DIR}/bvcLaunchDevKit.sh" "$@" ;;
  list)           exec "${SCRIPT_DIR}/bvcListDeployments.sh" "$@" ;;
  start)          exec "${SCRIPT_DIR}/bvcStartDeployment.sh" "$@" ;;
  stop)           exec "${SCRIPT_DIR}/bvcStopDeployment.sh" "$@" ;;
  delete)         exec "${SCRIPT_DIR}/bvcDeleteDeployment.sh" "$@" ;;
  help|--help|-h) print_help ;;
  *)              error_banner "Unknown command: $cmd"; print_help; exit 1 ;;
esac
