#!/usr/bin/env bash
set -euo pipefail

PROGNAME=$0
SCRIPT_DIR=$(cd -- "$(dirname -- "$0")" 2>/dev/null && pwd)

# shellcheck disable=SC1091
. "${SCRIPT_DIR}/private/shFunctions"

load_bvc_config
setup_traps

print_help() {
  cat <<EOF_HELP
Usage: $(prog_basename "$PROGNAME") <command> [args]

Commands:
  create <projectName>
      Create a new Catalyst project directory, then initialise it.

  init
      Initialise the current directory as a Catalyst project.

  devkit
      Build Catalyst DevKit if needed, then launch it.

  j4p
      Build Jadeite for Pharo if needed, then launch it.

  pull
      Sync configured Catalyst project sets.

  list
      List registered deployments and currently running stones.

  start <deploymentName> [--with-seaside]
      Start a deployment, building it first if needed.
      --with-seaside only affects build runs and installs seaside

  stop <deploymentName>
      Stop a deployment.

  delete <deploymentName> [-f|--force]
      Delete a deployment and its associated data.
      Prompts for confirmation unless --force is provided.

Examples:
  bvc create ThatGameCatalyst
  cd ThatGameCatalyst
  bvc devkit
  bvc j4p
  bvc pull
  bvc list
  bvc start tgc-prod-test --with-seaside
  bvc stop tgc-prod-test
  bvc delete tgc-prod-test

Notes:
- Config precedence: ENV > project config > bundled toolkit config > safety net.
- GsDevKit registry selection is internal and comes from DEFAULT_REGISTRY in config.
EOF_HELP
}

if [ $# -gt 0 ]; then
  cmd=$1
  shift
else
  cmd=help
fi

case "$cmd" in
  create)         exec "${SCRIPT_DIR}/bvcCreateProject.sh" "$@" ;;
  init)           exec "${SCRIPT_DIR}/bvcInitProject.sh" "$@" ;;
  devkit)         exec "${SCRIPT_DIR}/bvcLaunchDevKit.sh" "$@" ;;
  j4p)            exec "${SCRIPT_DIR}/bvcLaunchJadeiteForPharo.sh" "$@" ;;
  pull)           exec "${SCRIPT_DIR}/bvcPullProjects.sh" "$@" ;;
  list)           exec "${SCRIPT_DIR}/bvcListDeployments.sh" "$@" ;;
  start)          exec "${SCRIPT_DIR}/bvcStartDeployment.sh" "$@" ;;
  stop)           exec "${SCRIPT_DIR}/bvcStopDeployment.sh" "$@" ;;
  delete)         exec "${SCRIPT_DIR}/bvcDeleteDeployment.sh" "$@" ;;
  help|--help|-h) print_help ;;
  *)              error_banner "Unknown command: $cmd"; print_help; exit 1 ;;
esac
