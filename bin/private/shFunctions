# ---------------------------------------------------------
# Load BenjaVision Catalyst config (layered)
# Precedence (highest → lowest):
#   1. Environment variables (already set in ENV)
#   2. Project config root ($BVC_CONF_DIR, default: ./config relative to CWD)
#      └─ $BVC_CONF_DIR/bvc/bvc_defaults
#   3. Bundled toolkit defaults (../config/bvc/bvc_defaults relative to SCRIPT_DIR)
#   4. Hard-coded safety net (below)
#
# BVC_CONF_DIR is project config only. It does not change the bundled
# toolkit config root.
# ---------------------------------------------------------
load_bvc_config() {
  : "${SCRIPT_DIR:?SCRIPT_DIR must be set before calling load_bvc_config}"

  # 2) Resolve project config root. BVC_CONF_DIR only selects the project layer.
  : "${BVC_CONF_DIR:=config}"
  case "$BVC_CONF_DIR" in
    /*)  project_config_root="$BVC_CONF_DIR" ;;
    ~)   project_config_root="$HOME" ;;
    ~/*) project_config_root="$HOME/${BVC_CONF_DIR#~/}" ;;
    *)   project_config_root="$PWD/$BVC_CONF_DIR" ;;
  esac

  # 3) Resolve fixed toolkit config root.
  toolkit_root="$(cd -- "${SCRIPT_DIR}/.." 2>/dev/null && pwd)"
  toolkit_config_root="${toolkit_root}/config"

  BVC_PROJECT_CONFIG_ROOT="$project_config_root"
  BVC_TOOLKIT_ROOT="$toolkit_root"
  BVC_TOOLKIT_CONFIG_ROOT="$toolkit_config_root"

  # Backwards-compatible internal alias for older helper code in this repo.
  # Public/documented name is BVC_PROJECT_CONFIG_ROOT.
  CONF_DIR="$BVC_PROJECT_CONFIG_ROOT"

  if [ -r "$BVC_PROJECT_CONFIG_ROOT/bvc/bvc_defaults" ]; then
    . "$BVC_PROJECT_CONFIG_ROOT/bvc/bvc_defaults"
  fi

  bundled_config="$BVC_TOOLKIT_CONFIG_ROOT/bvc/bvc_defaults"
  [ -r "$bundled_config" ] && . "$bundled_config"

  : "${BVC_PROJECT_NAME:=BVCDevKit}"
  : "${DEFAULT_REGISTRY:=bvc}"
  : "${GSDEVKIT_STONES_DIR:=stones}"
  : "${PROJECTS_ROOT:=git_root}"
  : "${GEMSTONE_VERSION:=3.7.5}"
  : "${GEMSTONE_STONE_NAME:=bvc_dev}"
  : "${GT_INSTALL_DIR:=devkit}"
  : "${GT_APP_NAME:=${BVC_PROJECT_NAME}}"
  : "${J4P_INSTALL_DIR:=Jadeite4Pharo}"
  : "${J4P_PHARO_VERSION:=120}"
  : "${PHARO_INSTALL_DIR:=Pharo}"
  : "${PHARO_VERSION:=130}"
}

conf_resolve() {
  : "${BVC_PROJECT_CONFIG_ROOT:?BVC_PROJECT_CONFIG_ROOT must be set (call load_bvc_config first)}"
  : "${BVC_TOOLKIT_CONFIG_ROOT:?BVC_TOOLKIT_CONFIG_ROOT must be set (call load_bvc_config first)}"
  rel="$1"
  if [ -r "${BVC_PROJECT_CONFIG_ROOT}/${rel}" ]; then
    printf '%s\n' "${BVC_PROJECT_CONFIG_ROOT}/${rel}"
  elif [ -r "${BVC_TOOLKIT_CONFIG_ROOT}/${rel}" ]; then
    printf '%s\n' "${BVC_TOOLKIT_CONFIG_ROOT}/${rel}"
  else
    error_banner "Config not found in project or toolkit config: ${rel}"
    error_banner "Project config root: ${BVC_PROJECT_CONFIG_ROOT}"
    error_banner "Toolkit config root: ${BVC_TOOLKIT_CONFIG_ROOT}"
    exit 1
  fi
}

#===============================================
# Path helpers
#===============================================
abs_from_cwd() {
  p="$1"
  case "$p" in
    '')  printf %s "$PWD" ;;
    /*)  printf %s "$p" ;;
    ~)   printf %s "$HOME" ;;
    ~/*) printf %s "$HOME/${p#~/}" ;;
    *)   printf %s "$PWD/$p" ;;
  esac
}

path_from_script() {
  : "${SCRIPT_DIR:?}"
  p="$1"
  case "$p" in
    /*|~|~/*) abs_from_cwd "$p" ;;
    *)        printf %s "${SCRIPT_DIR}/$p" | sed 's:/*$::' ;;
  esac
}

projects_root() { abs_from_cwd "${PROJECTS_ROOT}"; }
project_set_dir() { printf %s "$(projects_root)/${1}"; }
set_rowan_home_for_projects() { export ROWAN_PROJECTS_HOME="$(project_set_dir projects)"; }
ensure_dir() { _d="$1"; [ -d "${_d}" ] || { information_banner "Creating directory: ${_d}"; mkdir -p "${_d}"; }; }

# Ensure shell scripts in the supplied directories are executable by the current user.
# Safe to call repeatedly; existing executable bits are left as-is.
bvc_ensure_shell_scripts_executable() {
  local dir

  if [ "$#" -eq 0 ]; then
    error_banner "No script directories supplied to bvc_ensure_shell_scripts_executable"
    return 1
  fi

  for dir in "$@"; do
    if [ ! -d "$dir" ]; then
      error_banner "Script directory does not exist: $dir"
      return 1
    fi

    information_banner "Ensuring shell scripts are executable under: $dir"
    find "$dir" -type f -name '*.sh' -exec chmod u+x {} \;
  done
}

#===============================================
# Feedback & Utilities
#===============================================
need() { command -v "$1" >/dev/null 2>&1 || { error_banner "Missing required tool: $1"; exit 1; }; }

_should_color() {
  [ -n "${NO_COLOR-}" ] && return 1
  [ "${BVC_FORCE_COLOR-}" = "1" ] && return 0
  [ -t 2 ] || return 1
  [ "${TERM-}" = "dumb" ] && return 1
  return 0
}

if _should_color; then
  ANSI_RESET="$(printf '\033[0m')"
  ANSI_BLUE="$(printf '\033[38;5;67m')"
  ANSI_GREEN="$(printf '\033[38;5;101m')"
  ANSI_YELLOW="$(printf '\033[38;5;144m')"
  ANSI_RED="$(printf '\033[38;5;131m')"
else
  ANSI_RED=''; ANSI_GREEN=''; ANSI_YELLOW=''; ANSI_BLUE=''; ANSI_RESET=''
fi

prog_basename() { bn="$1"; bn=${bn##*/}; printf %s "$bn"; }

exit_1_banner() {
  msg="$1"
  printf "%s%s :: %s%s\n" "${ANSI_RED}" "$msg" "$(prog_basename "$0")" "${ANSI_RESET}" 1>&2
  exit 1
}

exit_0_banner() {
  msg="$1"
  printf "%s%s :: %s%s\n" "${ANSI_GREEN}" "$msg" "$(prog_basename "$0")" "${ANSI_RESET}" 1>&2
  exit 0
}

start_banner() {
  theArgs="$*"
  printf "%s===========================%s\n" "${ANSI_BLUE}" "${ANSI_RESET}" 1>&2
  printf "%sBenjaVision Catalyst DevKit%s\n" "${ANSI_BLUE}" "${ANSI_RESET}" 1>&2
  printf "%sscript: %s %s%s\n" "${ANSI_BLUE}" "$(prog_basename "$0")" "${theArgs}" "${ANSI_RESET}" 1>&2
  printf "%s  path: %s%s\n" "${ANSI_BLUE}" "$0" "${ANSI_RESET}" 1>&2
  printf "%s===========================%s\n" "${ANSI_BLUE}" "${ANSI_RESET}" 1>&2
}

information_banner() { printf "%s%s%s\n" "${ANSI_BLUE}" "$1" "${ANSI_RESET}" 1>&2; }
warning_banner()     { printf "%s%s%s\n" "${ANSI_YELLOW}" "$1" "${ANSI_RESET}" 1>&2; }
error_banner()       { printf "%s%s%s\n" "${ANSI_RED}" "$1" "${ANSI_RESET}" 1>&2; }

interrupted() {
  lineno="$1"
  printf "%s^C detected (line %s) :: %s%s\n" "${ANSI_YELLOW}" "${lineno}" "$(prog_basename "$0")" "${ANSI_RESET}" 1>&2
  exit 1
}

error() {
  lineno="$1"
  exit_1_banner "Error on or near line ${lineno}"
}

#===============================================
# Spinner
#===============================================
spinner_pid=

spinner_start() {
  local spin='⣾⣽⣻⢿⡿⣟⣯⣷'
  local charwidth=3
  local i=0
  tput civis 2>/dev/null || true
  { while : ; do i=$(((i + charwidth) % ${#spin})) ; printf "%s" "$1 ${spin:i:charwidth}" ; printf "\r" ; sleep 0.1 ; done & } 2>/dev/null
  spinner_pid=$!
}

spinner_stop() {
  if [ -n "${spinner_pid:-}" ]; then
    { kill "$spinner_pid" && wait "$spinner_pid"; } 2>/dev/null || true
    spinner_pid=
    printf '\033[2K\r' 2>/dev/null || true
    tput cnorm 2>/dev/null || true
  fi
}
trap spinner_stop EXIT

#===============================================
# Platform / architecture
#===============================================
platform=
architecture=

set_platform_and_architecture() {
  uname_s="$(uname -s 2>/dev/null || echo unknown)"
  case "$uname_s" in
    Linux)
      arch_name="$(uname -m)"
      platform="Linux"
      case "$arch_name" in
        x86_64)  architecture="Linux64" ;;
        aarch64) architecture="LinuxArm64" ;;
        *) exit_1_banner "$arch_name architecture is unsupported." ;;
      esac
      ;;
    Darwin)
      platform="Mac"
      arch_name="$(uname -m)"
      is_m1=false
      if [ "$arch_name" = "x86_64" ]; then
        if [ "$(sysctl -in sysctl.proc_translated 2>/dev/null || echo 0)" = "1" ]; then
          is_m1=true
        fi
      elif [ "$arch_name" = "arm64" ]; then
        is_m1=true
      fi
      if [ "$is_m1" = true ]; then
        architecture="OSXM1"
      else
        architecture="OSX64"
      fi
      ;;
    MINGW*|MSYS*|CYGWIN*)
      platform="Win"
      architecture="Win64"
      ;;
    *)
      exit_1_banner "$uname_s is unsupported. Use macOS, Linux, or WSL."
      ;;
  esac
}

bvc_require_supported_platform() {
  uname_s="$(uname -s 2>/dev/null || echo unknown)"
  case "$uname_s" in
    Darwin|Linux) return 0 ;;
    MINGW*|MSYS*|CYGWIN*) exit_1_banner "Native Windows shells are not supported. Use WSL/Linux on Windows." ;;
    *) exit_1_banner "$uname_s is unsupported. Use macOS, Linux, or WSL." ;;
  esac
}

#===============================================
# GsDevKit registry helpers
#===============================================
bvc_parse_registry_stones() {
  awk "
    /#stones[[:space:]]*:/ {
      # Empty stones dictionaries are commonly printed on one line:
      #   #stones : { },
      # In that case, do not enter the following registry sections such as
      # #products, otherwise product versions like 3.7.5 are reported as stones.
      if (\$0 ~ /\\{[[:space:]]*\\}[[:space:]]*,?[[:space:]]*\$/) {
        in_stones = 0
        next
      }

      in_stones = 1
      next
    }

    in_stones && /^[[:space:]]*}[[:space:]]*,?[[:space:]]*\$/ {
      in_stones = 0
      next
    }

    in_stones {
      line = \$0
      sub(/^[[:space:]]*'/, \"\", line)
      sub(/'[[:space:]]*:.*/, \"\", line)
      if (line != \$0 && line != \"\") {
        print line
      }
    }
  "
}



# Write gt4gemstone connector definitions for every registered deployment stone.
# The file is consumed by the DevKit from:
#   ${GT_INSTALL_DIR}/pharo-local/lepiter/gt4gemstone.properties
# If the DevKit has not been built yet, this is intentionally a no-op; the
# DevKit build refreshes the file after installation.
bvc_refresh_gt4gemstone_properties() {
  local registry="${1:-${DEFAULT_REGISTRY}}"
  local gt_dir properties_dir properties_file registry_report_file
  local stone_count stone

  gt_dir="$(abs_from_cwd "${GT_INSTALL_DIR}")"

  if [ ! -d "${gt_dir}" ]; then
    information_banner "DevKit install directory not found; skipping gt4gemstone connector refresh: ${gt_dir}"
    return 0
  fi

  ensure_gsdevkit_ready

  properties_dir="${gt_dir}/pharo-local/lepiter"
  properties_file="${properties_dir}/gt4gemstone.properties"
  registry_report_file=$(mktemp "${TMPDIR:-/tmp}/bvc-registry-report.XXXXXX")

  # Connector refresh is a read-only operation. Do not initialise or mutate the
  # registry from here. Deployment start/build commands are responsible for
  # ensuring the registry exists before reaching this point.
  #
  # installSeasideDeploymentStone.sh exports STONE for gt4gemstone tooling. Some
  # GsDevKit_stones scripts treat STONE as an active stone context and may then
  # require GEMSTONE. Registry reporting must run outside that stone context.
  if ! ( unset STONE; registryReport.solo --registry="${registry}" > "${registry_report_file}" ); then
    rm -f "${registry_report_file}"
    warning_banner "Could not read GsDevKit registry '${registry}'; skipping gt4gemstone connector refresh."
    return 0
  fi

  mkdir -p "${properties_dir}"

  information_banner "Refreshing gt4gemstone connectors: ${properties_file}"

  {
    printf '{\n'
    printf '\t"__schema" : "4.1",\n'
    printf '\t"namedConnectors" : {\n'

    stone_count=0
    while IFS= read -r stone; do
      [ -n "${stone}" ] || continue

      if [ "${stone_count}" -gt 0 ]; then
        printf ',\n'
      fi

      printf '\t\t"%s" : {\n' "${stone}"
      printf '\t\t\t"__type" : "gemstoneGciConnector",\n'
      printf '\t\t\t"name" : "%s",\n' "${stone}"
      printf '\t\t\t"host" : "localhost",\n'
      printf '\t\t\t"serviceName" : "gemnetobject",\n'
      printf '\t\t\t"iconName" : "gemStone",\n'
      printf '\t\t\t"maxKeepAlive" : 30,\n'
      printf '\t\t\t"stone" : "%s",\n' "${stone}"
      printf '\t\t\t"netldi" : "%s_ldi",\n' "${stone}"
      printf '\t\t\t"username" : "DataCurator",\n'
      printf '\t\t\t"password" : "swordfish",\n'
      printf '\t\t\t"libraryPath" : {\n'
      printf '\t\t\t\t"__type" : "file",\n'
      printf '\t\t\t\t"filename" : "%s"\n' "${STONES_HOME}/gemstone/clientlibs"
      printf '\t\t\t},\n'
      printf '\t\t\t"gemstoneVersion" : "%s"\n' "${GEMSTONE_VERSION}"
      printf '\t\t}'

      stone_count=$((stone_count + 1))
    done < <(bvc_parse_registry_stones < "${registry_report_file}")

    if [ "${stone_count}" -gt 0 ]; then
      printf '\n'
    fi

    printf '\t}\n'
    printf '}\n'
  } > "${properties_file}"

  rm -f "${registry_report_file}"
  information_banner "gt4gemstone connectors refreshed (${stone_count} deployment(s))."
}

#===============================================
# GsDevKit / registry / install checks
#===============================================
gsdevkit_installed() {
  command -v versionReport.solo >/dev/null 2>&1 || return 1
  [ -n "${STONES_HOME:-}" ] && [ -d "$STONES_HOME" ] || return 1
}

ensure_gsdevkit_ready() {
  bvc_require_supported_platform
  if ! gsdevkit_installed; then
    information_banner "GsDevKit not found; bootstrapping."
    "${SCRIPT_DIR}/setupGsDevKit_stones.sh"
  fi
}

registry_exists() {
  name="$1"
  registryReport.solo --registry="$name" >/dev/null 2>&1
}

ensure_registry_exists() {
  name="$1"
  if ! registry_exists "$name"; then
    information_banner "Initialising GsDevKit registry '${name}'."
    "${SCRIPT_DIR}/initRegistry.sh" "$name"
  fi
}

deployment_exists() {
  registry="$1"
  deployment="$2"
  registryReport.solo --registry="$registry" --stone="$deployment" >/dev/null 2>&1
}

gt_installed() {
  gt_dir="$(abs_from_cwd "${GT_INSTALL_DIR}")"
  [ -e "${gt_dir}/${GT_APP_NAME}.image" ]
}

j4p_installed() {
  j4p_dir="$(abs_from_cwd "${J4P_INSTALL_DIR}")"
  [ -x "${j4p_dir}/pharo-ui" ] || [ -f "${j4p_dir}/pharo-ui" ]
}

setup_traps() {
  trap 'interrupted ${LINENO}' INT
  trap 'spinner_stop; error ${LINENO}' ERR
}
